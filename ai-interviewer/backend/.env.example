APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=auto

DATABASE_URL=postgresql+psycopg2://interviewer:interviewer@localhost:5433/interviewer
REDIS_URL=redis://localhost:6380/0

CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=interviewer_kb

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
RESUME_PARSER_LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

ASR_PROVIDER=openai
ASR_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Set to "postgres" for durable HITL — interviews survive process restarts.
# Requires psycopg[binary] and langgraph-checkpoint-postgres in requirements.
# With "memory" the API still works but interrupted sessions are lost on restart.
CHECKPOINT_BACKEND=postgres

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-interviewer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

THOMPSON_EXPLORATION_RATE=0.15
DEFAULT_MAX_TURNS=8
DEFAULT_QUALITY_THRESHOLD=7.5
DEFAULT_TURN_BUDGET=12

# Restore interrupted sessions from DB on startup (only effective with
# CHECKPOINT_BACKEND=postgres; MemorySaver loses checkpoints on restart).
REHYDRATE_BANDIT_ON_START=true

# Phase 0 scaffolding for slot-based context engineering. Keep OFF
# unless opting into the new ContextBuilder (Generator-only in PR-1).
USE_CONTEXT_BUILDER=false

# Per-agent LLM routing. JSON object: { role: model_id }. Empty map (the
# default) keeps every agent on LLM_MODEL. Recognised roles: generator,
# evaluator, verifier, guard, contract_negotiator, rubric_negotiator,
# session_summarizer, coach, llm_planner, strategy_dream.
# Example: LLM_MODEL_PER_AGENT={"evaluator":"gpt-4o","guard":"gpt-4o-mini"}
LLM_MODEL_PER_AGENT={}

# Evidence span alignment (see docs/PLAN_EVIDENCE_SPAN_ALIGNMENT.md).
# Enabled by default so evaluator evidence quotes can be traced back to
# concrete answer text. Evaluator additively populates
# acceptance_check_results[*].evidence_spans with {text,start,end,match}
# entries aligned to the candidate answer via stdlib difflib. No LLM
# call is added; spans are post-hoc string work. The evidence list itself
# stays unchanged regardless of this flag.
EVIDENCE_SPAN_ALIGNMENT=true
EVIDENCE_SPAN_FUZZY_THRESHOLD=0.6

# Verifier drift monitor (see docs/PLAN_VERIFIER_DRIFT.md). Records a
# DriftEvent after each verifier invocation; snapshot is read via
# GET /admin/drift/verifier. The default memory backend keeps one
# per-dimension rolling window per process. Use redis in multi-worker
# deployments so adaptive verifier trigger decisions read shared drift.
ENABLE_VERIFIER_DRIFT_MONITOR=false
VERIFIER_DRIFT_WINDOW_SIZE=200
VERIFIER_DRIFT_BACKEND=memory
VERIFIER_DRIFT_REDIS_PREFIX=agentic_interviewer:verifier_drift

# Adaptive verifier trigger (feedback loop from drift monitor back
# into should_trigger). Opt-in. Requires ENABLE_VERIFIER_DRIFT_MONITOR
# to also be ON. Once the per-dimension rolling window has at least
# VERIFIER_ADAPTIVE_MIN_SAMPLES entries:
#   override_rate >= HIGH → force verifier call on clean passes too
#   override_rate <= LOW  AND score > threshold + margin → skip verifier
#   otherwise              → pass through to the baseline rule set
# Marginal passes still always run the verifier regardless of drift.
VERIFIER_ADAPTIVE_TRIGGER=false
VERIFIER_ADAPTIVE_HIGH_THRESHOLD=0.25
VERIFIER_ADAPTIVE_LOW_THRESHOLD=0.05
VERIFIER_ADAPTIVE_MIN_SAMPLES=30

# Strategy promotion scheduler (see app/tasks/strategy_promotion_tasks.py).
# In-process APScheduler that periodically refreshes strategy memory stats,
# promotes signals to strategies, and applies quality transitions
# (active/stabilized/disabled). The admin UI surfaces scheduler state in
# the StrategiesCard "自动晋升" tile. Keep OFF if you only want manual
# runs triggered via the "立即运行一次" button. Defaults match the code
# defaults in settings.py so the values shown here are also the values
# used if the variables are absent — they are explicit for operator
# visibility, not because they differ from the defaults.
ENABLE_STRATEGY_PROMOTION_SCHEDULER=false
STRATEGY_PROMOTION_INTERVAL_MINUTES=60
STRATEGY_PROMOTION_STARTUP_DELAY_MINUTES=5

# ---------------------------------------------------------------------------
# Rate limit knobs (high-cost setup endpoints: /resume/parse, /jd/parse,
# /llm/test). Values are per client IP per ``RATE_LIMIT_WINDOW_SECONDS``.
#
# IMPORTANT - multi-worker deployment:
# RATE_LIMIT_BACKEND=memory is process-local and multiplies the effective
# ceiling by worker/pod count. Use RATE_LIMIT_BACKEND=redis for production
# shared-state deployments, or add an upstream limiter that enforces the
# canonical ceiling before traffic reaches the app.
# Without one of the above, expect cost amplification on the LLM-backed
# endpoints (resume/jd parse) under abusive traffic.
# ---------------------------------------------------------------------------
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_PREFIX=agentic_interviewer:rate_limit
RATE_LIMIT_WINDOW_SECONDS=60
RESUME_PARSE_RATE_LIMIT_PER_MINUTE=20
JD_PARSE_RATE_LIMIT_PER_MINUTE=30
LLM_TEST_RATE_LIMIT_PER_MINUTE=120

# Voice WebSocket one-time ticket backend. Keep memory for local dev; use
# redis in multi-worker preview/prod so a ticket issued by one worker can be
# consumed exactly once by another.
VOICE_TICKET_BACKEND=memory
VOICE_TICKET_REDIS_PREFIX=agentic_interviewer:voice_ticket

# ---------------------------------------------------------------------------
# Privacy lifecycle. Cleanup is opt-in because it hard-deletes persisted
# interview rows. Defaults follow Settings: session/trace rows are retained
# for 30 days, outcome rows for 180 days. Preview/prod deployments that need
# shorter retention should set these values explicitly in their environment
# instead of changing code defaults.
# ---------------------------------------------------------------------------
ENABLE_PRIVACY_CLEANUP=false
PRIVACY_CLEANUP_INTERVAL_MINUTES=60
SESSION_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
OUTCOME_RETENTION_DAYS=180
PRIVACY_CLEANUP_BATCH_SIZE=500
